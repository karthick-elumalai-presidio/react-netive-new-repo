# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV['CI'] # optimize fastlane for CI environments (no prompts, keychain setup, hide output)
  end
  
  desc "Match certificates and provisioning profiles for App Store"
  lane :match_appstore do
    if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
      match(type: "appstore", readonly: true, git_url: ENV['MATCH_GIT_URL'])
    else
      UI.error("MATCH_GIT_URL not configured. Please set it up.")
    end
  end

  desc "Match certificates and provisioning profiles for development"
  lane :match_development do
    if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
      match(type: "development", readonly: true, git_url: ENV['MATCH_GIT_URL'])
    else
      UI.error("MATCH_GIT_URL not configured. Please set it up.")
    end
  end

  desc "Build debug version (default lane alias)"
  lane :build do
    build_debug
  end

  desc "Build debug version"
  lane :build_debug do
    automatic_code_signing(
      path: "CbMmobileapp.xcodeproj",
      use_automatic_signing: true,
      team_id: ENV['APPLE_TEAM_ID']
    )

    update_project_team(
      path: "CbMmobileapp.xcodeproj",
      teamid: ENV['APPLE_TEAM_ID']
    )

    build_app(
      workspace: "CbMmobileapp.xcworkspace",
      scheme: "CbMmobileapp",
      configuration: "Debug",
      export_method: "development",
      export_options: {
        signingStyle: "automatic",
        provisioningProfiles: {
          "com.anonymous.CbM-mobile-app" => ""
        },
        compileBitcode: false
      },
      team_id: ENV['APPLE_TEAM_ID'],
      automatic_code_signing: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Automatic"
    )
  end

  desc "Build and upload to TestFlight"
  lane :deploy_testflight do
    if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
      match(type: "appstore", readonly: true, git_url: ENV['MATCH_GIT_URL'])
    else
      UI.important("⚠️  MATCH_GIT_URL not set - skipping certificate sync")
    end
    
    build_app(
      workspace: "CbMmobileapp.xcworkspace",
      scheme: "CbMmobileapp",
      configuration: "Release",
      export_method: "app-store"
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and upload to App Store"
  lane :deploy_appstore do
    if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
      match(type: "appstore", readonly: true, git_url: ENV['MATCH_GIT_URL'])
    else
      UI.important("⚠️  MATCH_GIT_URL not set - skipping certificate sync")
    end
    
    build_app(
      workspace: "CbMmobileapp.xcworkspace",
      scheme: "CbMmobileapp",
      configuration: "Release",
      export_method: "app-store"
    )
    
    upload_to_app_store(
      force: true,
      skip_metadata: true,
      skip_screenshots: true
    )
  end

  # Builds a development-signed IPA and stores it at ios/build/ios/dev.ipa
  desc "Build development IPA artifact"
  lane :build_dev_ipa do
    if ENV['MATCH_GIT_URL'] && !ENV['MATCH_GIT_URL'].empty?
      match(type: "development", readonly: true, git_url: ENV['MATCH_GIT_URL'])
    else
      UI.important("⚠️  MATCH_GIT_URL not set - skipping certificate sync")
    end

    build_app(
      workspace: "CbMmobileapp.xcworkspace",
      scheme: "CbMmobileapp",
      configuration: "Debug",
      export_method: "development",
      output_directory: "build/ios",
      output_name: "dev.ipa",
      team_id: ENV['APPLE_TEAM_ID'],
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Automatic"
    )
  end

  # Uploads a previously built IPA to TestFlight without rebuilding
  # Usage: bundle exec fastlane upload_testflight_ipa ipa:path/to/file.ipa
  desc "Upload an existing IPA to TestFlight"
  lane :upload_testflight_ipa do |options|
    ipa_path = options[:ipa]
    UI.user_error!("Please provide ipa: path/to/file.ipa") if ipa_path.to_s.strip.empty?

    # Use App Store Connect API or Apple ID credentials
    if ENV['APP_STORE_CONNECT_API_KEY_JSON']
      UI.success("✅ Using App Store Connect API Key for upload")
      api_key = app_store_connect_api_key(
        key_id: JSON.parse(ENV['APP_STORE_CONNECT_API_KEY_JSON'])["key_id"],
        issuer_id: JSON.parse(ENV['APP_STORE_CONNECT_API_KEY_JSON'])["issuer_id"],
        key: JSON.parse(ENV['APP_STORE_CONNECT_API_KEY_JSON'])["key"]
      )
      upload_to_testflight(
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        api_key: api_key
      )
    elsif ENV['APPLE_ID'] && ENV['APPLE_APP_SPECIFIC_PASSWORD']
      UI.success("✅ Using Apple ID credentials for upload")
      upload_to_testflight(
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        apple_id: ENV['APPLE_ID'],
        password: ENV['APPLE_APP_SPECIFIC_PASSWORD'],
        team_id: ENV['APPLE_TEAM_ID']
      )
    else
      UI.error("❌ No authentication configured for TestFlight upload")
      UI.error("Set either APP_STORE_CONNECT_API_KEY_JSON or APPLE_ID + APPLE_APP_SPECIFIC_PASSWORD")
    end
  end

  # Builds an App Store signed IPA and stores it at ios/build/ios/release.ipa
  desc "Build App Store (Release) IPA artifact"
  lane :build_appstore_ipa do
    # Use automatic code signing with Apple Team ID
    if ENV['APPLE_TEAM_ID'] && !ENV['APPLE_TEAM_ID'].empty?
      UI.success("✅ Using automatic code signing with Team ID: #{ENV['APPLE_TEAM_ID']}")
      
      # Update project to use automatic signing
      # Explicitly set code_sign_identity to empty string to clear any manual settings
      update_code_signing_settings(
        path: "CbMmobileapp.xcodeproj",
        use_automatic_signing: true,
        team_id: ENV['APPLE_TEAM_ID'],
        code_sign_identity: "",  # Clear any manual identity
        targets: ["CbMmobileapp"],
        build_configurations: ["Release"]
      )
    else
      UI.error("❌ APPLE_TEAM_ID not set - automatic signing will fail")
      UI.error("Please set APPLE_TEAM_ID in your environment or GitHub Secrets")
    end

    build_app(
      workspace: "CbMmobileapp.xcworkspace",
      scheme: "CbMmobileapp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "release.ipa",
      export_options: {
        method: "app-store",
        teamID: ENV['APPLE_TEAM_ID'],
        signingStyle: "automatic",
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      }
    )
  end

  # Uploads an existing IPA directly to App Store (no rebuild)
  desc "Upload an existing IPA to App Store"
  lane :upload_appstore_ipa do |options|
    ipa_path = options[:ipa]
    UI.user_error!("Please provide ipa: path/to/file.ipa") if ipa_path.to_s.strip.empty?

    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_metadata: true,
      skip_screenshots: true
    )
  end
end
