{
  "name": "CbM_mobile_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:android": "expo build:android",
    "build:ios": "expo build:ios",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx,css}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx,css}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json,css}\" --write",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css}\"",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests configured yet\" && exit 0",
    "test:coverage": "echo \"No test coverage configured yet\" && exit 0",
    "web": "expo start --web",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.9",
    "expo-linking": "~8.0.8",
    "expo-localization": "~17.0.7",
    "expo-router": "~6.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "husky": "^9.1.7",
    "i18next": "^25.5.3",
    "md5": "^2.3.0",
    "nativewind": "4.1.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.64.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.76.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.1.12",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@tanstack/eslint-plugin-query": "^5.91.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "bun run format"
    ]
  }
}
